# =============================================================================
# calserver configuration
# =============================================================================
# Copy this file to config.toml and pass it with -config config.toml.
#
#   calserver -config config.toml
#
# Every value here is optional and shown with its built-in default. Any value
# left out falls back to that default. Command-line flags OVERRIDE the file:
# `calserver -config config.toml -addr :9000` uses :9000 regardless of what
# [server].addr says. Unknown keys are rejected at startup rather than silently
# ignored, so a typo fails fast.


# SERVER
# =============================================================================
# HTTP listener and the WebDAV mount point.
[server]
addr = ":8080"          # Listen address (host:port; ":8080" = all interfaces).
metrics_addr = ""       # Second listener serving Prometheus /metrics and Go
                        # /debug/pprof, e.g. "127.0.0.1:9464". Plain HTTP, no
                        # auth: bind loopback or a firewalled interface, never
                        # the public one. Empty = disabled.
base_uri = "/"          # URI prefix the server is mounted at (e.g. "/dav/").
realm = "SabreDAV"      # Auth realm. MUST match the realm baked into
                        # users.digesta1 in the shared database, forever, for
                        # both Digest and Basic (see PLAN.md §5).
temp_file_filter = false # Intercept OS junk files (._*, .DS_Store, Thumbs.db,
                        # editor swap files) into a scratch directory instead of
                        # the backend, like sabre's TemporaryFileFilterPlugin
                        # (sabre's example server enables it; core does not).
temp_file_dir = ""      # Scratch directory for temp_file_filter. Empty = a
                        # calserver-tempfiles subdir of the system temp dir.
                        # Files are never auto-deleted; sweep it externally.

# TLS / HTTPS. Leave both empty to serve plain HTTP (terminate TLS in front,
# e.g. behind a reverse proxy). Basic/Digest send credentials, so if calserver
# is edge-facing, set both to enable HTTPS here.
[server.tls]
cert = ""               # Path to the TLS certificate (PEM). Enables HTTPS.
key = ""                # Path to the TLS private key (PEM). Required with cert.

# AUTHENTICATION VIA rcptd (optional)
# -----------------------------------------------------------------------------
# By default, Basic/Digest logins are verified against the users.digesta1 column
# in the database. Set url below to instead authenticate against an rcptd
# daemon's /auth endpoint: rcptd serves the user's Dovecot password hashes and
# calserver verifies the password locally (the same source of truth as the mail
# stack). This mode is Basic-only (rcptd serves no digesta1, so Digest is
# disabled) — front the server with TLS, and pair with
# calendarserver.auto_provision below so first-time logins get a principal and
# a default calendar/address book. Leave url empty to use the users table.
[server.rcptd]
url = ""                # rcptd base URL, e.g. "http://127.0.0.1:8090". Empty
                        # disables rcptd auth (use the database instead).
token = ""              # Bearer token rcptd requires (its auth_token). May also
                        # be supplied via the $RCPTD_AUTH_TOKEN environment
                        # variable, which keeps the secret out of the file.


# DATABASE
# =============================================================================
# Postgres connection to the sabre-compatible schema. Empty runs an in-memory
# server (no persistence) for WebDAV/litmus testing only.
[database]
dsn = ""                # e.g. "postgres://user@localhost/calserver?sslmode=disable"
# Connection-pool bounds. Optional; the defaults (max_open 20, max_idle 5,
# lifetime 5m) leave headroom under a Postgres shared with a live sabre
# instance. Raise max_open_conns only if that database has connections to
# spare. conn_max_lifetime is a Go duration ("5m", "30s") and recycles
# connections across failovers/poolers.
# max_open_conns = 20
# max_idle_conns = 5
# conn_max_lifetime = "5m"


# LOGGING
# =============================================================================
# level sets the verbosity of the structured (slog) log on stderr. Rejected
# logins are logged at "warn" (with the attempted username and client address,
# never the password); successful logins and a per-request trace are at "debug".
# The -log-level flag overrides this key; when neither is set, the
# $CALSERVER_LOG_LEVEL environment variable applies (handy for raising verbosity
# via systemd without editing this file). calclient honours the same flag/env.
#
# access_log emits one structured line per request (method, path, status, bytes,
# duration) into the main log above, so it shares that log's rotation/shipping.
# It logs no bodies, so unlike request_dir it is safe to leave on. The line's
# level tracks the status: 5xx at error, other 4xx at warn, everything else
# (including the routine 401 auth challenge) at info — so raising level to "warn"
# surfaces only failing requests. The -access-log flag overrides this key.
#
# When request_dir is set, every request/response is additionally dumped to one
# file per request under that directory (method, path, headers, and bounded
# request and response bodies). The Authorization header is redacted, but the
# bodies hold calendar/contact data — this is a DAV-client debugging aid, NOT
# for production. Leave empty to disable.
[logging]
level = "info"          # debug, info, warn, or error. Empty = info.
access_log = false      # one slog line per request into the main log.
request_dir = ""        # e.g. "/var/tmp/calserver-requests". Empty = disabled.


# SCHEDULING
# =============================================================================
# iMIP emails invitations to attendees who are not local principals. Leave smtp
# empty to disable outbound email (local iTIP delivery still works).
[scheduling.imip]
smtp = ""               # SMTP host:port, e.g. "mail.example.org:587".
sender = ""             # Envelope sender (MAIL FROM) and, by default, the From
                        # header of invitation emails.
send_as_organizer = false  # true: put the scheduling sender's own address in
                        # the From header instead — the organizer for invites,
                        # the attendee for replies (always a local principal);
                        # sender stays the envelope sender (a split sender).
                        # Only safe when your SMTP relay can DKIM-sign for those
                        # local domain(s), or recipients fail DMARC and junk the
                        # mail. A malformed sender address falls back to sender.


# CALENDAR SERVER COMPATIBILITY
# =============================================================================
# Optional Apple Calendar Server behaviors. Every one is OFF by default so the
# server matches sabre/dav (the parity target). Turn these on only when you
# specifically want Calendar-Server semantics.
[calendarserver]
browser = false             # Serve an HTML index on GET of a collection
                            # (sabre answers 501 without its Browser plugin).
auto_provision = false      # Recreate the default calendar/addressbook when a
                            # principal has none left.
per_user_props = false      # Store a delegate's calendar-color/-order per user
                            # so it does not clobber the owner's values.
expand_groups = false       # Expand a group ATTENDEE into a display-only
                            # X-SERVER-GROUP placeholder plus one invitation
                            # per member.
principals_readable = false # Let any authenticated user read principal
                            # resources (delegation UIs browse other users).

# Principal-name prefixes whose scheduling messages are auto-accepted
# (resources/rooms auto-book, declining on a free-busy conflict). Empty
# disables auto-scheduling.
auto_schedule_prefixes = []  # e.g. ["resource", "location"]


# ACCOUNT RETENTION
# =============================================================================
# Soft-delete retention. `calctl principal delete <user>` schedules an account
# for deletion instead of removing it immediately: the account can no longer
# log in, but its data is kept until the window below elapses, at which point
# `calctl principal purge-expired` (run from cron) removes it for good. Restore
# within the window with `calctl principal restore <user>`.
[retention]
deleted_days = 30           # Days to keep a soft-deleted account before purge.
                            # 0 uses the built-in default (30). Changing this
                            # never moves an already-scheduled purge.


# WEBDAV-PUSH
# =============================================================================
# Server-initiated change notifications (PUSH-PLAN.md), so clients that speak
# WebDAV-Push (DAVx5 >= 4.4.2, and this project's web client) learn of calendar
# / address-book changes within seconds instead of polling. Delivered as
# encrypted Web Push (RFC 8030/8291) authenticated with VAPID (RFC 8292).
# Note: iOS/macOS Calendar do NOT support WebDAV-Push and are unaffected.
#
# Generate the VAPID keypair once, e.g. `calserver push-keys` or the npm
# `web-push generate-vapid-keys`, and a random topic_secret (e.g.
# `openssl rand -base64 32`). The private key and topic secret are SECRETS:
# keep this file out of version control and readable only by the service user.
# When enabled = true, all three of vapid_public_key, vapid_private_key and
# topic_secret must be set or the server refuses to start.
[push]
enabled = false             # Master switch for WebDAV-Push.
vapid_subject = ""          # RFC 8292 'sub' claim, e.g. "mailto:admin@example.com".
vapid_public_key = ""       # base64url P-256 VAPID public key.
vapid_private_key = ""      # base64url P-256 VAPID private key (SECRET).
topic_secret = ""           # HMAC key for opaque per-collection topics (SECRET).
